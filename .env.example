# NBPDCL Meter Billing Automator - Environment Configuration

# SaaS API Authentication
NBPDCL_API_KEY=your_api_key_here
NBPDCL_API_BASE=https://meterreaing.nexgentech.site/api/v1
NBPDCL_AUTH_MODE=bearer

# Default MRU and Cycle
NBPDCL_MRU_CODE=8
NBPDCL_CYCLE=OCT-2026

# Smart Average Batch Tuning Defaults
NBPDCL_MIN_FLOOR=125

# ADB Device Serial / IP
ADB_DEVICE_SERIAL=192.168.9.40:5555
