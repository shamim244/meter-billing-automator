# NBPDCL Billing Copilot - Environment Configuration
# Copy this file, fill in your credentials, and keep it out of version control.

# --- Required: NBPDCL REST API v1 (https://meterreaing.nexgentech.site/api/v1) ---
NBPDCL_API_KEY=nbp_live_RGw507grj9XgHCY3oTpjQazHZ3m5JjG0P6HOLE3z

# Base URL of the NBPDCL SaaS API server
NBPDCL_API_BASE=https://meterreaing.nexgentech.site/api/v1

# Which auth scheme to use: "bearer" or "apikey"
NBPDCL_AUTH_MODE=bearer

# --- Optional: MRU / cycle defaults used when queue endpoint is called without params ---
NBPDCL_MRU_CODE=6
NBPDCL_CYCLE=OCT-2026

# --- Optional: ADB device serial (empty = first connected device) ---
ADB_DEVICE_SERIAL=192.168.9.40:5555